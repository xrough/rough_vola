include LICENSE README.md CITATION.cff pyproject.toml
recursive-include docs *.md *.json
recursive-include examples *.py *.md
recursive-include scripts *.py
recursive-include notebooks *.ipynb *.md .order
recursive-include reports *.md *.json *.csv *.html
recursive-include tests *.py *.md
recursive-include src/rvlab/tests/fixtures *.py *.json *.npz
recursive-include .github/workflows *.yml *.yaml
global-exclude __pycache__ *.py[cod] .DS_Store
prune notebooks/_output
prune build
